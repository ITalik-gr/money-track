{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "money-track",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// SPA served from the Vite build output, worker handles API/webhook/ingest.
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// ⚠️ Load-bearing. With SPA fallback the asset router answers *navigation* requests
		// (browser GET, Accept: text/html) itself and never wakes the Worker — so `<a href>`
		// links to Worker routes silently rendered index.html and React Router showed its own
		// "404 Not Found". It looked like the routes were unregistered; they were not.
		// The bug was invisible on `fetch` calls (POST /api/login worked fine), which is what
		// made it read as "Google login is broken" rather than "assets shadow the Worker".
		// Listed per-prefix rather than `true`, so plain static hits don't pay a Worker invocation.
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/demo",
			"/webhook/*",
			"/tg/*",
			"/ingest/*",
			// MCP (§MCP). Outside `/api/*`, so without this line the static-asset router would
			// answer it — and the symptom would be an MCP client reporting invalid JSON, which
			// reads as a broken server rather than as "the SPA shell was returned instead".
			"/mcp",
			// §MCP-OAUTH. `/.well-known/*` is the one Anthropic's own docs single out as the
			// classic Cloudflare failure: without it the asset router serves the SPA shell, the
			// client never finds the authorization server, and the only symptom is "couldn't
			// reach the MCP server" with no traffic at the OAuth endpoints at all.
			"/.well-known/*",
			"/oauth/*",
			// The service worker normally answers this one itself (a POST share target is
			// delivered to the SW, never to the network). It is listed anyway for the window where
			// the SW is updating or was unregistered: without it, a shared photo lands on the
			// static-asset router as a POST and is lost with a 405.
			"/share-receipt"
		]
	},
	"observability": {
		"enabled": true
	},
	// D1: fill database_id after `wrangler d1 create finance`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "finance",
			"database_id": "843a4f84-a5f5-4a6d-83c7-48b35c521c4b",
			"migrations_dir": "./migrations"
		},
		// Directory: the ONLY shared storage in the multi-user design (PLATFORM.md §2).
		// Identity and invites live here; every financial row lives in the user's own
		// Durable Object. Kept as a D1 (not a directory-DO) so the registry stays
		// inspectable with `wrangler d1 execute` while debugging invites/logins.
		{
			"binding": "DIRECTORY",
			"database_name": "directory",
			"database_id": "c72e2571-1fbb-44b2-8308-5a961aef9670",
			"migrations_dir": "./migrations-directory"
		}
	],
	// Durable Object: one per user, holds that user's whole finance database (PLATFORM.md §2).
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_DO",
				"class_name": "UserDO"
			}
		]
	},
	// `new_sqlite_classes` (not `new_classes`) — the DO must be SQLite-backed; the key-value
	// backend has no `ctx.storage.sql` and the whole approach depends on it.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"UserDO"
			]
		}
	],
	// R2: bucket created via `wrangler r2 bucket create finance-receipts`.
	"r2_buckets": [
		{
			"binding": "RECEIPTS",
			"bucket_name": "finance-receipts"
		}
	],
	// Weekly insight + weekly AI report (Mon 09:00), monthly AI report (1st 09:00),
	// daily notification feed + rates (06:00 UTC ≈ 08:00 Kyiv). Each fires a fan-out to every
	// user's Durable Object (worker/lib/platform/cron.ts).
	//
	// The former minute-cron is GONE: it existed to pace the backfill (mono allows 1 req/60s),
	// and that now lives in `UserDO.alarm()`. As a global cron it would have woken every user's
	// object 1440 times a day just to find nothing to do.
	"triggers": {
		"crons": [
			"0 9 * * 1",
			"0 9 1 * *",
			"0 6 * * *"
		]
	},
	"vars": {
		"APP_TZ": "Europe/Kyiv",
		// Registration policy. "open" — anyone with a Google account signs themselves up;
		// "invite" restores the whitelist (POST /api/admin/users/invite) without a code change.
		// A disabled account is refused in either mode — that is the ban.
		"SIGNUP": "open"
	}
}