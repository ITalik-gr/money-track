{
  "name": "money-track",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc -b && node scripts/check-stats-sql.mjs && node scripts/check-i18n.mjs && node scripts/gen-migrations.mjs --check",
    "check:sql": "node scripts/check-stats-sql.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply finance --local",
    "db:migrate:remote": "wrangler d1 migrations apply finance --remote",
    "db:seed:local": "wrangler d1 execute finance --local --file ./migrations/0002_seed.sql",
    "db:dir:migrate:local": "wrangler d1 migrations apply directory --local",
    "db:dir:migrate:remote": "wrangler d1 migrations apply directory --remote"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@reduxjs/toolkit": "^2.5.0",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "wrangler": "^4.107.0"
  }
}
