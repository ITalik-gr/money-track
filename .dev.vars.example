# Copy to .dev.vars for local dev. Real secrets go via `wrangler secret put` in prod.
# .dev.vars is gitignored — never commit real tokens.

MONO_TOKEN=
ANTHROPIC_API_KEY=
# Secret path segment for the mono webhook, e.g. a random uuid. The webhook URL
# becomes https://<worker>/webhook/<WEBHOOK_SECRET>
WEBHOOK_SECRET=
# ⚠️ LEGACY. Парольного входу вже НЕМА (вхід тільки через Google, 2026-07-26). Змінна лишилась
# єдиним фолбеком ключа підпису сесій у `lib/platform/auth.ts` — задавай SESSION_SECRET нижче,
# а це поле лишай порожнім.
APP_PASSWORD=

# --- Мультиюзер (PLATFORM.md §3) ---------------------------------------------
# Google OAuth: створити проєкт у Google Cloud Console, OAuth client type "Web
# application", redirect URI = https://<worker>/auth/google/callback
# (локально — http://127.0.0.1:8799/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ключ підпису сесійної куки. Окремий від APP_PASSWORD, щоб зміна пароля не
# розлогінювала всіх, і щоб сесії пережили прибирання парольного входу.
SESSION_SECRET=
# Пошта власника інсталяції — під нею заводиться owner-рядок у directory.
# ⚠️ Мусить збігатись із Google-акаунтом власника, інакше перший вхід через
# Google скаже «not_invited», а дані лишаться під owner-id.
OWNER_EMAIL=
# Шифрує per-user ключі (mono/Anthropic) у базі юзера. `openssl rand -hex 32`.
# ⚠️ Втрата/ротація = збережені ключі юзерів треба вводити заново.
SECRETS_MASTER_KEY=
# Окремий Anthropic-ключ для публічного демо (P4.3). Дай йому власний білінг-ліміт на боці
# Anthropic — останній рубіж за per-session/global капами. Не заданий → демо-AI бере звичайний
# ключ (усе одно капнутий + примусово Haiku).
DEMO_ANTHROPIC_KEY=

# --- Telegram-бот (опційно) ---------------------------------------------------
# Без цих трьох бот просто не активується — застосунок працює повністю, лише без пушів у TG.
# Токен від @BotFather.
TG_BOT_TOKEN=
# Секретний сегмент шляху вебхука бота (/tg/<TG_SECRET>) + значення заголовка
# X-Telegram-Bot-Api-Secret-Token. Будь-який випадковий рядок.
TG_SECRET=
# ⚠️ Chat_id ВЛАСНИКА і лише його. Це deployment-секрет, тож він owner-only (§D1): решта юзерів
# привʼязують свій чат самі, через deep-link у Налаштуваннях, і їхній chat_id живе в їхньому DO.
TG_CHAT_ID=
